; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DumbyStealsAWarplaneBiggerVer"
config/tags=PackedStringArray("bigproject", "important")
run/main_scene="uid://djxndtog5nfd5"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="res://Art/planestuff/Dumby_steals (1).png"
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bgevmm307tb6g"

[autoload]

g="*res://GlobalSingletons/global.gd"
SceneManager="*uid://j20v4cg7v8m1"
GlobalSignals="*res://GlobalSingletons/GlobalSignals.gd"
SaveLoad="*res://saveSystem/SaveLoad.gd"
AudioManager="*res://GlobalSingletons/audioManagerGlobals/AudioManager.tscn"
References="*res://GlobalSingletons/References.gd"
PlayerStats="*res://GlobalSingletons/PlayerStats.gd"
MusicManager="*res://GlobalSingletons/musicManager/music_manager.tscn"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Art/": "red",
"res://Audio/": "orange",
"res://AudioManager/": "teal",
"res://CompositionStuff/": "green",
"res://GlobalSingletons/": "yellow",
"res://Localization/": "green",
"res://classes/": "yellow",
"res://entities/": "teal",
"res://game_screens/": "blue",
"res://input_mapper/": "purple",
"res://juices/": "pink",
"res://projectiles/": "red",
"res://projectiles/other_stuff/": "orange",
"res://resources/": "orange",
"res://saveSystem/": "yellow",
"res://scenes/": "green",
"res://settingsMenu/": "teal",
"res://shaders/": "blue",
"res://shop/": "red",
"res://timer/": "pink"
}

